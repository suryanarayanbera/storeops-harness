<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.1.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.1.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

  <!--
    Domain and DTO types are records holding already-immutable values (String, enum, Instant)
    or lists defensively copied with List.copyOf in the compact constructor. SpotBugs still
    reports the generic "may expose internal representation" pattern for record accessors.
  -->
  <Match>
    <Or>
      <Package name="~com\.cognizant\.storeops\..*\.domain"/>
      <Package name="~com\.cognizant\.storeops\..*\.dto"/>
      <Package name="com.cognizant.storeops.shared.events"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>

  <!--
    Spring injects singleton collaborators into @Component/@Service/@RestController fields;
    storing the reference is the framework contract, not a defect.
  -->
  <Match>
    <Or>
      <Package name="~com\.cognizant\.storeops\..*\.service"/>
      <Package name="~com\.cognizant\.storeops\..*\.routes"/>
      <Package name="~com\.cognizant\.storeops\..*\.listener"/>
      <Package name="~com\.cognizant\.storeops\.shared\..*"/>
    </Or>
    <Bug pattern="EI_EXPOSE_REP2,CT_CONSTRUCTOR_THROW"/>
  </Match>
</FindBugsFilter>
